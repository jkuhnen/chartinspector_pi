+template <typename TObject>
+wxString ChartInspectorFormatAttributes(TObject* obj) {
+  if (!obj || !obj->att_array || !obj->attVal || obj->n_attr <= 0)
+    return wxString();
+
+  wxString result;
+  const int count = wxMin(obj->n_attr, 24);
+  for (int i = 0; i < count; ++i) {
+    char acronym[7] = {0};
+    std::memcpy(acronym, obj->att_array + (6 * i), 6);
+
+    S57attVal* value = obj->attVal->Item(i);
+    if (!value || !value->value) continue;
+
+    wxString text;
+    switch (value->valType) {
+      case OGR_STR:
+        text = wxString::FromUTF8(static_cast<const char*>(value->value));
+        break;
+      case OGR_REAL:
+        text.Printf("%g", *static_cast<double*>(value->value));
+        break;
+      case OGR_INT:
+        text.Printf("%d", *static_cast<int*>(value->value));
+        break;
+      default:
+        continue;
+    }
+
+    if (!result.IsEmpty()) result += "\n";
+    result += wxString::FromUTF8(acronym) + "=" + text;
+  }
+  return result;
+}
+
+bool ChartInspectorSamePoint(double lat1, double lon1, double lat2,
+                             double lon2) {
+  double dlat = lat1 - lat2;
+  double dlon = lon1 - lon2;
+  if (dlat < 0.0) dlat = -dlat;
+  if (dlon < 0.0) dlon = -dlon;
+  return dlat < 1e-7 && dlon < 1e-7;
+}
