+namespace {
+
+int ChartInspectorFeaturePriority(const char* feature) {
+  if (!feature || !feature[0]) return 0;
+
+  if (!std::strncmp(feature, "BOY", 3) || !std::strncmp(feature, "BCN", 3))
+    return 300;
+  if (!std::strcmp(feature, "LIGHTS")) return 250;
+  if (!std::strcmp(feature, "WRECKS") || !std::strcmp(feature, "UWTROC") ||
+      !std::strcmp(feature, "OBSTRN"))
+    return 200;
+  return 100;
+}
+
+void ChartInspectorCopyString(char* dst, int dst_size, const char* src) {
+  if (!dst || dst_size <= 0) return;
+  dst[0] = '\0';
+  if (!src) return;
+  std::strncpy(dst, src, static_cast<size_t>(dst_size - 1));
+  dst[dst_size - 1] = '\0';
+}
+
+}  // namespace
