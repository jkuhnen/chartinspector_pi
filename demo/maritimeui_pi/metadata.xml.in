<?xml version="1.0" encoding="UTF-8"?>
<plugin version="1">
  <name>Maritime UI Demo</name>
  <version>@PACKAGE_VERSION@</version>
  <release>0</release>
  <summary>Maritime HMI design demonstrator for OpenCPN</summary>
  <api-version>@OCPN_API_VERSION@</api-version>
  <open-source>yes</open-source>
  <author>Johannes Kuhnen</author>
  <source>https://github.com/jkuhnen/chartinspector_pi</source>
  <description>
    Standalone OpenCPN plugin used to evaluate a navigation-oriented maritime
    user interface with DAY, DUSK and NIGHT colour schemes, clear information
    hierarchy and reserved safety colours.
  </description>
  <target>@OCPN_PACKAGE_TARGET@</target>
  <build-target>@OCPN_BUILD_TARGET@</build-target>
  <target-version>@OCPN_TARGET_VERSION@</target-version>
  <target-arch>@OCPN_TARGET_ARCH@</target-arch>
</plugin>
