<?xml version="1.0" encoding="UTF-8"?>
<plugin version="1">
  <name>Chart Inspector</name>
  <version>@PACKAGE_VERSION@</version>
  <release>0</release>
  <summary>Interactive inspection of vector chart objects in OpenCPN</summary>

  <api-version>@OCPN_API_VERSION@</api-version>
  <open-source>yes</open-source>
  <author>Johannes Kuhnen</author>
  <source>https://github.com/kuhnentrion/chartinspector_pi</source>

  <description>
    Chart Inspector adds direct interaction with vector chart features, including hover highlighting, direct object selection and quick access to feature metadata and attributes.
  </description>

  <target>@OCPN_PACKAGE_TARGET@</target>
  <build-target>@OCPN_BUILD_TARGET@</build-target>
  <target-version>@OCPN_TARGET_VERSION@</target-version>
  <target-arch>@OCPN_TARGET_ARCH@</target-arch>
  <info-url>https://github.com/kuhnentrion/chartinspector_pi</info-url>
</plugin>
